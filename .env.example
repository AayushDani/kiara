# No credentials are needed for the explicitly labeled local demonstration.
KIARA_AUTH_MODE=demo_simulated
KIARA_MODEL_MODE=scripted
KIARA_EMAIL_MODE=preview
KIARA_PUBLIC_BASE_URL=http://localhost:3000
# Real provider adapters (never commit populated values)
MONGODB_URI=
MONGODB_DB=kiara
OPENAI_API_KEY=
KIARA_MODEL=gpt-6-astra
KIARA_REASONING_EFFORT=medium
KIARA_SESSION_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
KIARA_EMAIL_FROM=
KIARA_LAWYER_EMAIL=
KIARA_FOUNDER_EMAIL=
# Change only after explicit authorization to send real email.
KIARA_ALLOW_LIVE_EMAIL=false

# Hosted demo: strong generated passwords, SHA-256 hashes only in server env.
# KIARA_AUTH_MODE=hosted_password
# KIARA_WORKER_MODE=vercel_workflow
KIARA_FOUNDER_PASSWORD_HASH=
KIARA_LAWYER_PASSWORD_HASH=

# Public hackathon: isolated visitors, role switching, automatic final-approval reset.
# KIARA_AUTH_MODE=public_demo
# Requires a strong KIARA_SESSION_SECRET, scripted model, and email preview mode.
