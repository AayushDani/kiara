{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "tenant_id",
        "schema_version",
        "created_at",
        "document_id",
        "revision_number",
        "parent_revision_id",
        "base_revision_id",
        "format",
        "clauses",
        "content_hash",
        "created_by",
        "source_run_id",
        "language",
        "title",
        "policy_updated_on",
        "synthetic",
        "reset_epoch"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "tenant_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "schema_version": {
          "bsonType": "string",
          "enum": [
            "kiara.document_revision.v1"
          ]
        },
        "created_at": {
          "bsonType": "date"
        },
        "document_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_number": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parent_revision_id": {
          "anyOf": [
            {
              "bsonType": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "base_revision_id": {
          "anyOf": [
            {
              "bsonType": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "format": {
          "bsonType": "string",
          "enum": [
            "clause_json_v1"
          ]
        },
        "clauses": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": [
              "clause_id",
              "heading",
              "body"
            ],
            "additionalProperties": false,
            "properties": {
              "clause_id": {
                "bsonType": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "heading": {
                "bsonType": "string",
                "maxLength": 256
              },
              "body": {
                "bsonType": "string",
                "maxLength": 50000
              }
            }
          },
          "maxItems": 200,
          "minItems": 1
        },
        "content_hash": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_by": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source_run_id": {
          "anyOf": [
            {
              "bsonType": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "language": {
          "bsonType": "string",
          "maxLength": 20
        },
        "title": {
          "bsonType": "string",
          "maxLength": 256
        },
        "policy_updated_on": {
          "bsonType": "string",
          "maxLength": 10
        },
        "synthetic": {
          "bsonType": "bool"
        },
        "reset_epoch": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
