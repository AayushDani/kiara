{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "tenant_id",
        "schema_version",
        "created_at",
        "source_version_id",
        "source_hash",
        "chunk_index",
        "provision_key",
        "locator",
        "text",
        "content_hash",
        "jurisdiction",
        "effective_from",
        "effective_to",
        "topics",
        "reset_epoch"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "tenant_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "schema_version": {
          "bsonType": [
            "int",
            "long"
          ],
          "enum": [
            1
          ]
        },
        "created_at": {
          "bsonType": "date"
        },
        "source_version_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source_hash": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunk_index": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provision_key": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "locator": {
          "bsonType": "object",
          "required": [
            "section",
            "pages",
            "start_char",
            "end_char",
            "offset_basis",
            "excerpt_path"
          ],
          "additionalProperties": false,
          "properties": {
            "section": {
              "bsonType": "string",
              "maxLength": 300
            },
            "pages": {
              "bsonType": "array",
              "items": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxItems": 100,
              "minItems": 0
            },
            "start_char": {
              "anyOf": [
                {
                  "bsonType": [
                    "int",
                    "long"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "bsonType": "null"
                }
              ]
            },
            "end_char": {
              "anyOf": [
                {
                  "bsonType": [
                    "int",
                    "long"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "bsonType": "null"
                }
              ]
            },
            "offset_basis": {
              "bsonType": "string",
              "enum": [
                "full_extracted_text",
                "page_excerpt_file"
              ]
            },
            "excerpt_path": {
              "anyOf": [
                {
                  "bsonType": "string",
                  "maxLength": 512
                },
                {
                  "bsonType": "null"
                }
              ]
            }
          }
        },
        "text": {
          "bsonType": "string",
          "maxLength": 100000
        },
        "content_hash": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "jurisdiction": {
          "bsonType": "string",
          "maxLength": 32
        },
        "effective_from": {
          "anyOf": [
            {
              "bsonType": "date"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "effective_to": {
          "anyOf": [
            {
              "bsonType": "date"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "topics": {
          "bsonType": "array",
          "items": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
          },
          "maxItems": 30,
          "minItems": 0
        },
        "reset_epoch": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
