{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "properties": {
        "tenant_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "run_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "invocation_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider_call_id": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tool_name": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tool_schema_version": {
          "enum": [
            "0.1.0"
          ]
        },
        "input_sha256": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "idempotency_key": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "bsonType": "string",
          "enum": [
            "started",
            "completed",
            "failed"
          ]
        },
        "result_record_id": {
          "anyOf": [
            {
              "bsonType": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "bsonType": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "bsonType": "object",
              "properties": {
                "code": {
                  "bsonType": "string",
                  "enum": [
                    "FORBIDDEN",
                    "NOT_FOUND",
                    "INVALID_ARGUMENT",
                    "STALE_SNAPSHOT",
                    "CONFLICT",
                    "SOURCE_UNAVAILABLE",
                    "SOURCE_EXPIRED",
                    "BUDGET_EXHAUSTED",
                    "LOST_LEASE",
                    "REPEATED_TOOL_CYCLE",
                    "INTERNAL_ERROR",
                    "RESULT_TOO_LARGE",
                    "CAPACITY_EXCEEDED",
                    "STALE_RESET_EPOCH"
                  ]
                },
                "message": {
                  "bsonType": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "retryable": {
                  "bsonType": "bool"
                },
                "correlation_id": {
                  "bsonType": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "reset_epoch": {
                  "bsonType": [
                    "int",
                    "long"
                  ],
                  "minimum": 1
                }
              },
              "required": [
                "code",
                "message",
                "retryable",
                "correlation_id",
                "reset_epoch"
              ],
              "additionalProperties": false
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "fencing_token": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0
        },
        "started_at": {
          "bsonType": "date"
        },
        "completed_at": {
          "anyOf": [
            {
              "bsonType": "date"
            },
            {
              "bsonType": "null"
            }
          ]
        },
        "reset_epoch": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 1
        },
        "_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "schema_version": {
          "bsonType": [
            "int",
            "long"
          ],
          "enum": [
            1
          ]
        },
        "created_at": {
          "bsonType": "date"
        }
      },
      "required": [
        "_id",
        "tenant_id",
        "run_id",
        "invocation_id",
        "provider_call_id",
        "tool_name",
        "tool_schema_version",
        "input_sha256",
        "snapshot_sha256",
        "idempotency_key",
        "status",
        "result_record_id",
        "result_sha256",
        "error",
        "fencing_token",
        "started_at",
        "completed_at",
        "reset_epoch",
        "schema_version",
        "created_at"
      ],
      "additionalProperties": false
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
