{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "tenant_id",
        "schema_version",
        "created_at",
        "external_key",
        "display_name",
        "email",
        "synthetic",
        "residency_evidence",
        "state_version",
        "reset_epoch"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "tenant_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "schema_version": {
          "bsonType": [
            "int",
            "long"
          ],
          "enum": [
            1
          ]
        },
        "created_at": {
          "bsonType": "date"
        },
        "external_key": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "display_name": {
          "bsonType": "string",
          "maxLength": 120
        },
        "email": {
          "bsonType": "string",
          "maxLength": 254
        },
        "synthetic": {
          "bsonType": "bool"
        },
        "residency_evidence": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": [
              "evidence_type",
              "country",
              "region",
              "declared_at",
              "verification_status",
              "source_event_id"
            ],
            "additionalProperties": false,
            "properties": {
              "evidence_type": {
                "bsonType": "string",
                "enum": [
                  "declared_legal_residence",
                  "street_address",
                  "billing_address",
                  "ip_geolocation"
                ]
              },
              "country": {
                "bsonType": "string",
                "maxLength": 2
              },
              "region": {
                "bsonType": "string",
                "maxLength": 2
              },
              "declared_at": {
                "bsonType": "date"
              },
              "verification_status": {
                "bsonType": "string",
                "enum": [
                  "self_declared",
                  "verified",
                  "unknown"
                ]
              },
              "source_event_id": {
                "anyOf": [
                  {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "bsonType": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 20,
          "minItems": 0
        },
        "state_version": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reset_epoch": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
