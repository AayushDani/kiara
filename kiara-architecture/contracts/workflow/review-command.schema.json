{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiara.example/contracts/K-REVIEW-002",
  "title": "K-REVIEW-002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "expected_reset_epoch",
    "expected_state_version",
    "proposal_id",
    "candidate_revision_id",
    "review_bundle_id",
    "review_bundle_hash",
    "expected_base_revision_id",
    "idempotency_key",
    "action",
    "feedback_id"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "expected_reset_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expected_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "candidate_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "review_bundle_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "review_bundle_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_base_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "viewed",
        "reviewed",
        "requested_changes",
        "rejected",
        "approved"
      ]
    },
    "feedback_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
