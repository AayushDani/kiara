{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiara.example/contracts/K-WF-RECORD-001",
  "title": "K-WF-RECORD-001",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "tenant_id",
    "reset_epoch",
    "company_id",
    "document_id",
    "trigger_event_id",
    "correlation_id",
    "state",
    "state_version",
    "last_event_seq",
    "intake_seq",
    "active_run_id",
    "active_proposal_id",
    "review_bundle_id",
    "document_slot_epoch",
    "pinned_base_revision_id",
    "founder_approval_id",
    "lawyer_approval_id",
    "wait",
    "last_error",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reset_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "company_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "document_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "trigger_event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "waiting_for_document_slot",
        "retrieving_context",
        "assessing",
        "needs_information",
        "drafting",
        "validating",
        "repairing",
        "needs_human_review",
        "awaiting_founder",
        "awaiting_lawyer",
        "ready_to_finalize",
        "finalized",
        "closed_no_change",
        "rejected",
        "superseded",
        "failed"
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "intake_seq": {
      "type": "integer",
      "minimum": 0
    },
    "active_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_proposal_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_bundle_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "document_slot_epoch": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "pinned_base_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "founder_approval_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lawyer_approval_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "wait": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "since",
            "required_role",
            "reason_code"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "information",
                "human_review",
                "founder",
                "lawyer",
                "document_slot"
              ]
            },
            "since": {
              "type": "string",
              "format": "date-time"
            },
            "required_role": {
              "type": "string",
              "enum": [
                "founder",
                "lawyer",
                "operator",
                "workflow_service"
              ]
            },
            "reason_code": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
