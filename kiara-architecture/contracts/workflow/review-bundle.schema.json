{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiara.example/contracts/K-REVIEW-001",
  "title": "K-REVIEW-001",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_bundle_id",
    "review_input",
    "review_input_hash",
    "validation_run_id",
    "validation_hash",
    "validator_version_id",
    "review_bundle_hash",
    "sealed_at"
  ],
  "properties": {
    "review_bundle_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "review_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "legal_map_id",
        "legal_map_hash",
        "renderer_version",
        "validator_version_id",
        "validator_config_hash",
        "tenant_id",
        "reset_epoch",
        "company_id",
        "document_id",
        "workflow_id",
        "proposal_id",
        "base_revision_id",
        "base_content_hash",
        "candidate_revision_id",
        "candidate_content_hash",
        "diff_id",
        "diff_hash",
        "context_snapshot_id",
        "context_snapshot_hash",
        "evidence_bundle_id",
        "evidence_bundle_hash",
        "assessment_id",
        "assessment_hash",
        "run_id",
        "harness_version_id",
        "harness_hash",
        "material_context_epoch",
        "material_evidence_epoch",
        "source_recheck_attestation_ids",
        "freshness_valid_until"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "legal_map_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "legal_map_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "renderer_version": {
          "type": "string",
          "minLength": 1
        },
        "validator_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "validator_config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "reset_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "company_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "document_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "workflow_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "base_revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "base_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "candidate_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "diff_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_snapshot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "context_snapshot_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_bundle_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "evidence_bundle_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assessment_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "assessment_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "harness_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "harness_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "material_context_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "material_evidence_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "source_recheck_attestation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "freshness_valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review_input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation_run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "validation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validator_version_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "review_bundle_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    }
