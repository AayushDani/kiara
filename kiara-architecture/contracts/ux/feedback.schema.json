            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "replacement_text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 20000
            },
            "selection_anchor": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "document_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "revision_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "clause_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "clause_content_hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "field": {
                      "enum": [
                        "heading",
                        "body"
                      ]
                    },
                    "offset_units": {
                      "const": "utf16_code_units"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "exact_text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "url_path": {
                      "type": "string",
                      "pattern": "^/documents/"
                    }
                  },
                  "required": [
                    "document_id",
                    "revision_id",
                    "clause_id",
                    "clause_content_hash",
                    "field",
                    "offset_units",
                    "start",
                    "end",
                    "exact_text",
                    "url_path"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "revision_id",
            "clause_id",
            "clause_content_hash",
            "instruction",
            "replacement_text",
            "selection_anchor"
          ]
        }
      },
      "required": [
        "schema_version",
        "command_id",
        "workflow_id",
        "expected_reset_epoch",
        "expected_state_version",
        "review_bundle_id",
        "review_bundle_hash",
        "proposal_id",
        "candidate_revision_id",
        "expected_base_revision_id",
        "idempotency_key",
        "feedback_id",
        "reason",
        "feedback_type",
        "payload"
      ]
    },
