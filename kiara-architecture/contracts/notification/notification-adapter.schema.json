{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiara.example.test/contracts/notification-adapter/v1",
  "title": "T10 notification adapter boundary, not the whole T09 outbox schema",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "notification_id",
        "tenant_id",
        "workflow_id",
        "review_bundle_id",
        "recipient_actor_id",
        "notification_kind",
        "transport",
        "dedupe_key",
        "payload_hash",
        "review_url",
        "payload",
        "first_attempt_at",
        "retry_until",
        "attempt_count"
      ],
      "properties": {
        "contract_id": {
          "const": "NotificationDispatchV1"
        },
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "workflow_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_bundle_id": {
          "type": "string",
          "format": "uuid"
        },
        "recipient_actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "notification_kind": {
          "enum": [
            "founder_review_requested",
            "lawyer_review_requested",
            "document_finalized"
          ]
        },
        "transport": {
          "enum": [
            "preview",
            "resend"
          ]
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "subject",
            "html",
            "text"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "email"
            },
            "to": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "format": "email"
              }
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "html": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "first_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retry_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "notification_id",
        "transport",
        "notification_state",
        "provider_message_id",
        "error_code",
        "recorded_at"
      ],
      "properties": {
        "contract_id": {
          "const": "NotificationDispatchResultV1"
        },
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "transport": {
          "enum": [
            "preview",
            "resend"
          ]
        },
        "notification_state": {
          "enum": [
            "previewed",
            "sent",
            "retry_wait",
            "failed",
            "unknown_delivery"
          ]
        },
        "provider_message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "preview"
              }
            }
          },
          "then": {
            "properties": {
              "notification_state": {
                "const": "previewed"
              },
              "provider_message_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "notification_state": {
                "const": "sent"
              }
            }
          },
          "then": {
            "properties": {
              "transport": {
                "const": "resend"
              },
              "provider_message_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
