          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidate_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "diff_id",
        "base_revision_id",
        "base_content_hash",
        "candidate_revision_id",
        "candidate_content_hash",
        "diff_hash",
        "artifact_path"
      ]
