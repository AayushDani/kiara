        "base_content_hash",
        "candidate_revision_id",
        "candidate_content_hash",
        "diff_id",
        "diff_hash",
        "legal_map_id",
        "legal_map_hash",
        "evidence_bundle_id",
        "evidence_bundle_hash",
        "context_snapshot_id",
        "context_snapshot_hash",
        "assessment_id",
        "assessment_hash",
        "harness_version_id",
        "harness_hash",
        "reset_epoch",
        "material_context_epoch",
        "material_evidence_epoch",
        "source_recheck_attestation_ids",
        "freshness_valid_until",
        "renderer_version",
        "validator_version_id",
        "validator_config_hash"
