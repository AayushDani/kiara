              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "op",
            "clause_id",
            "expected_clause_hash"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "replace_clause"
            },
            "clause_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "expected_clause_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "clause": {
              "$ref": "#/$defs/clause"
            }
          },
          "required": [
            "op",
            "clause_id",
            "expected_clause_hash",
            "clause"
          ]
