    "review_bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_bundle_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "review_input": {
          "$ref": "#/$defs/review_input"
        },
        "review_input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validation_run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "validation_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validator_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sealed_at": {
          "type": "string"
        },
        "review_bundle_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "review_bundle_id",
        "review_input",
        "review_input_hash",
        "validation_run_id",
        "validation_hash",
        "validator_version_id",
        "sealed_at",
        "review_bundle_hash"
      ]
    },
    "review_command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "expected_reset_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidate_revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "review_bundle_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
