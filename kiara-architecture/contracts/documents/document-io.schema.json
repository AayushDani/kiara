          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_base_revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": {
          "enum": [
            "viewed",
            "reviewed",
            "requested_changes",
            "rejected",
            "approved"
          ]
        },
        "feedback_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "required": [
        "workflow_id",
        "expected_state_version",
        "expected_reset_epoch",
        "proposal_id",
        "candidate_revision_id",
        "review_bundle_id",
        "review_bundle_hash",
        "expected_base_revision_id",
        "action",
        "feedback_id",
        "idempotency_key"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "BASE_REVISION_CONFLICT",
                "PARENT_HASH_CONFLICT",
                "STATE_VERSION_CONFLICT",
                "RESET_EPOCH_CONFLICT",
                "INVALID_CLAUSE_OPERATION",
                "NOT_FOUND_OR_NOT_AUTHORIZED",
                "BUNDLE_SUPERSEDED",
                "VALIDATION_INPUT_MISMATCH",
                "VALIDATION_NOT_PASSED",
                "DEPENDENCY_INVALIDATED",
                "SOURCE_STALE",
                "STALE_REVIEW_BUNDLE",
                "WRONG_REVIEW_ROLE",
                "FOUNDER_GATE_NOT_SATISFIED",
                "EXPORT_FORMAT_UNSUPPORTED",
                "DIFF_LIMIT_EXCEEDED",
                "DOCUMENT_TOO_LARGE"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "current_state_version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_reset_epoch": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "current_state_version",
            "current_reset_epoch"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "edit": {
      "oneOf": [
