        "material_context_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "material_evidence_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "source_recheck_attestation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "freshness_valid_until": {
          "type": "string",
          "minLength": 1
        },
        "renderer_version": {
          "type": "string",
          "minLength": 1
        },
        "validator_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "validator_config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
