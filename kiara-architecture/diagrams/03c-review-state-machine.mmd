flowchart TB
  V["Checks passed<br/>Seal candidate, context, sources and verdict"]
  F["Awaiting founder<br/>Explicit approval of current packet"]
  L["Awaiting lawyer<br/>Explicit approval of the same packet"]
  G{"Recheck freshness, integrity,<br/>base revision and both approvals"}
  O["Finalize internally<br/>Advance policy; record output event"]
  R["Requested changes / legal note<br/>Invalidate packet; repair and validate"]
  E["Direct document edit<br/>New immutable revision; validate"]
  C["Fact proposal<br/>Founder verifies; advance context<br/>Reassess, regenerate and validate"]
  X["Rejected<br/>Retain history; do not finalize"]
  V --> F --> L --> G --> O
  F -->|"Feedback"| R
  L -->|"Feedback"| R
  R -->|"All checks pass"| V
  F -->|"Edit"| E
  L -->|"Edit"| E
  E -->|"All checks pass"| V
  F -->|"Fact correction"| C
  L -->|"Fact correction proposal"| C
  C -->|"All checks pass"| V
  F -->|"Reject"| X
  L -->|"Reject"| X
  G -->|"Changed or stale inputs"| S["Block stale approval<br/>Refresh inputs and revalidate before approving"]
  classDef human fill:#fff2d9,stroke:#ac751c,color:#5e3c09;
  classDef finish fill:#e8f4ed,stroke:#39744d,color:#214d31;
  class F,L human;
  class O finish;
